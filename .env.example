# AI Hawkeye deployment environment

# Comma-separated origins allowed to call the Flask API.
# Examples:
# AI_HAWKEYE_ALLOWED_ORIGINS=https://your-user.github.io,https://www.example.com
AI_HAWKEYE_ALLOWED_ORIGINS=

# Upload limit in MB. Default is 1024.
AI_HAWKEYE_MAX_UPLOAD_MB=1024

# Optional custom Good-Badminton runtime directory.
# Usually leave unset outside Docker.
AI_HAWKEYE_GOOD_ROOT=

# Docker Compose static site port.
HTTP_PORT=8080
